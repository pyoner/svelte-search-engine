{
	"name": "svelte-search-engine",
	"description": "A wrapper for Google's Programmable Search Engine, providing a Svelte-friendly interface.",
	"version": "1.1.0-alpha.0",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && npm run package",
		"preview": "vp preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp test",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"prepare": "vp config"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"default": "./dist/plugins/index.js"
		},
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"default": "./dist/stores/index.js"
		},
		"./api": {
			"types": "./dist/api/index.d.ts",
			"default": "./dist/api/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"keywords": [
		"google",
		"google-programmable-search",
		"programmable-search",
		"programmable-search-engine",
		"search-engine",
		"svelte",
		"svelte-kit",
		"svelte-wrapper",
		"svelte-component",
		"typescript"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^25.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.18.0",
		"globals": "^17.6.0",
		"publint": "^0.3.21",
		"svelte": "^5.55.10",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.1.23",
		"vite-plus": "^0.1.23",
		"vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.23"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pyoner/svelte-search-engine.git"
	},
	"license": "MIT",
	"publishConfig": {
		"tag": "alpha"
	},
	"packageManager": "bun@1.3.14",
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.1.23",
		"vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.23"
	}
}
